# Copy this file to `.env.local` and fill in the values you need.
# Never commit real secrets. Only NEXT_PUBLIC_* values reach the browser.

# Public site URL. Used for canonical URLs, Open Graph and JSON-LD.
# Set this in every deployed environment. If unset, the app falls back to
# http://localhost:3000, which would publish localhost URLs to search engines.
NEXT_PUBLIC_SITE_URL=https://example.com

# Origin of the TheraViva backend (see backend/README.md). Used by the patient
# and admin dashboards, and the first-party engagement beacon. In development it
# defaults to http://localhost:8000.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional analytics. Leave both unset to keep tracking off entirely.
# Even when set, nothing loads until the visitor accepts the consent banner.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
