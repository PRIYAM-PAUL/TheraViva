# TheraViva backend — copy to `.env` and adjust. Never commit real secrets.

# --- Core -----------------------------------------------------------------
THERAVIVA_ENV=development
THERAVIVA_DEBUG=false
THERAVIVA_DATABASE_URL=sqlite+aiosqlite:///./var/theraviva.db
THERAVIVA_AUTO_CREATE_TABLES=true

# --- Security -------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
THERAVIVA_SECRET_KEY=dev-insecure-secret-change-me-in-production-0000000000
THERAVIVA_ACCESS_TOKEN_MINUTES=30
THERAVIVA_REFRESH_TOKEN_DAYS=30
THERAVIVA_CORS_ORIGINS=http://localhost:3000

# Bootstrap admin (created on first startup if no admin exists).
THERAVIVA_ADMIN_EMAIL=admin@theraviva.local
THERAVIVA_ADMIN_PASSWORD=admin12345

# Bootstrap staff (created on first startup if that role has no user yet).
# Reception handles bookings/payments; therapist owns schedule + clinical notes.
THERAVIVA_RECEPTION_EMAIL=reception@theraviva.local
THERAVIVA_RECEPTION_PASSWORD=reception12345
THERAVIVA_THERAPIST_EMAIL=therapist@theraviva.local
THERAVIVA_THERAPIST_PASSWORD=therapist12345

# --- OTP ------------------------------------------------------------------
# In development the OTP is fixed to this value and logged (never sent).
THERAVIVA_OTP_DEV_CODE=123456
THERAVIVA_OTP_TTL_MINUTES=10

# --- Storage --------------------------------------------------------------
THERAVIVA_STORAGE_DIR=./var/storage

# --- Providers (free + open source; swap without touching callers) --------
# payments: manual | fake
THERAVIVA_PAYMENT_PROVIDER=manual
# email: fake | smtp
THERAVIVA_EMAIL_PROVIDER=fake
THERAVIVA_SMTP_HOST=
THERAVIVA_SMTP_PORT=587
THERAVIVA_SMTP_USERNAME=
THERAVIVA_SMTP_PASSWORD=
THERAVIVA_EMAIL_FROM=TheraViva <no-reply@theraviva.local>
# messaging: fake | waha
THERAVIVA_MESSAGING_PROVIDER=fake
THERAVIVA_WAHA_BASE_URL=http://localhost:3000
THERAVIVA_WAHA_API_KEY=
THERAVIVA_WAHA_SESSION=default
# sms: console | fake
THERAVIVA_SMS_PROVIDER=console

# --- Business -------------------------------------------------------------
THERAVIVA_GST_RATE=0.18
THERAVIVA_RATE_LIMIT_PER_MINUTE=120
